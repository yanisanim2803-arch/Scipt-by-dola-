local stalking = false
local orbiting = false

-- 1. Fling (พุ่งชนเป้าหมายให้ปลิวกระเด็น - ฮิตสุด)
addBtn("🌪️ ชนเป้าหมายปลิว (Fling)", Color3.fromRGB(200, 50, 50), function()
    local t = getTarget()
    if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") and player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        local spin = Instance.new("BodyAngularVelocity")
        spin.AngularVelocity = Vector3.new(0, 99999, 0)
        spin.MaxTorque = Vector3.new(0, math.huge, 0)
        spin.Parent = hrp
        
        for i = 1, 20 do
            hrp.CFrame = t.Character.HumanoidRootPart.CFrame
            task.wait(0.05)
        end
        spin:Destroy()
    end
end)

-- 2. เกาะหัวเป้าหมาย
addBtn("🐒 ขี่คอเป้าหมาย", Color3.fromRGB(200, 100, 50), function()
    stalking = not stalking
    local t = getTarget()
    while stalking and t and t.Character and t.Character:FindFirstChild("Head") do
        player.Character.HumanoidRootPart.CFrame = t.Character.Head.CFrame + Vector3.new(0, 2, 0)
        task.wait()
    end
end)

-- 3. วิ่งวนรอบตัวเป้าหมาย
addBtn("🌀 วิ่งวนกวนตีน", Color3.fromRGB(150, 50, 200), function()
    orbiting = not orbiting
    local t = getTarget()
    local angle = 0
    while orbiting and t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") do
        angle = angle + 0.1
        local offset = Vector3.new(math.cos(angle) * 5, 0, math.sin(angle) * 5)
        player.Character.HumanoidRootPart.CFrame = t.Character.HumanoidRootPart.CFrame + offset
        task.wait()
    end
end)

-- 4. วาร์ปไปหาคนแบบสุ่มดักหน้า
addBtn("🎲 วาร์ปหลอนๆ (สุ่มคน)", Color3.fromRGB(50, 150, 200), function()
    local players = game.Players:GetPlayers()
