-- ระบบหาผู้เล่นจากชื่อย่อ
local function getTarget()
    local txt = string.lower(targetInput.Text)
    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= player and string.sub(string.lower(v.Name), 1, string.len(txt)) == txt or string.sub(string.lower(v.DisplayName), 1, string.len(txt)) == txt then
            return v
        end
    end
    return nil
end

-- สร้างปุ่ม
local function addBtn(text, color, func)
    local btn = Instance.new("TextButton")
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = scroll
    btn.MouseButton1Click:Connect(func)
end

